---
permalink: /assets/css/base.css
eleventyExcludeFromCollections: true
---
/* Base: reset, typography, layout, accessibility primitives. Colors come from tokens (src/_data/tokens.json). */
*, *::before, *::after { box-sizing: border-box; }
html { font-size: calc(100% * var(--a11y-font-scale, 1)); -webkit-text-size-adjust: 100%; scroll-padding-top: 5rem; }
body {
  margin: 0; background: var(--c-bg); color: var(--c-text);
  font-family: var(--font-base); line-height: var(--a11y-line-height, 1.5);
}
h1, h2, h3 { font-family: var(--font-heading); line-height: 1.2; margin: 0 0 0.5em; }
h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); }
h2 { font-size: 1.5rem; }
img, svg { max-width: 100%; height: auto; }
a { color: var(--c-link); }
a:hover { text-decoration-thickness: 2px; }
[data-a11y-underline="true"] a { text-decoration: underline !important; }
[data-a11y-font="readable"] { --font-base: Verdana, Tahoma, "Trebuchet MS", sans-serif; --font-heading: Verdana, Tahoma, sans-serif; letter-spacing: 0.02em; word-spacing: 0.08em; }

.container { width: min(100% - 2rem, var(--max-width)); margin-inline: auto; }
.section { padding-block: 2rem; }
.prose { max-width: 70ch; }
.meta { color: var(--c-muted); }

:focus-visible { outline: 3px solid var(--c-focus); outline-offset: 2px; }
main:focus { outline: none; }

.visually-hidden {
  position: absolute !important; width: 1px; height: 1px; margin: -1px; padding: 0;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}
.skip-link {
  position: absolute; left: 0.5rem; top: -4rem; z-index: 100; padding: 0.75rem 1rem;
  background: var(--c-primary); color: var(--c-primary-text); border-radius: var(--radius);
}
.skip-link:focus { top: 0.5rem; }

.site-header { background: var(--c-primary); color: var(--c-primary-text); position: sticky; top: 0; z-index: 20; }
.site-header :focus-visible { outline-color: var(--c-accent); }
.site-header__inner { display: flex; align-items: center; gap: 1rem 1.5rem; padding-block: 0.75rem; flex-wrap: wrap; }
.promo-bar { background: var(--c-accent); color: var(--c-accent-text); font-size: 0.9rem; }
.promo-bar p { margin-block: 0; padding-block: 0.4rem; text-align: center; }
.site-header__icons { display: flex; align-items: center; gap: 0.5rem; }
.site-menu { background: var(--c-bg); border-bottom: 1px solid var(--c-border); }
.site-menu__inner { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 1.5rem; padding-block: 0.5rem; }
.site-menu .site-nav a { color: var(--c-text); text-decoration: none; }
.site-menu .site-nav a:hover, .site-menu .site-nav a[aria-current="page"] { text-decoration: underline; text-underline-offset: 0.3em; }
.site-header__brand { font-weight: 800; font-size: 1.5rem; letter-spacing: -0.02em; color: var(--c-primary-text); text-decoration: none; }
.site-logo { display: block; height: 2rem; width: auto; }
.site-nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; list-style: none; margin: 0; padding: 0; }
.site-nav a { color: inherit; display: inline-block; padding: 0.5rem 0.25rem; min-height: 2.75rem; line-height: 1.75rem; }
.site-nav a[aria-current="page"] { font-weight: 700; text-decoration-thickness: 2px; }
.site-footer { margin-top: 3rem; padding-block: 1.5rem; background: var(--c-surface); border-top: 1px solid var(--c-border); }
.site-footer__columns { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
.site-footer ul { list-style: none; margin: 0; padding: 0; }
.site-footer li a { display: inline-block; min-height: 2rem; line-height: 2rem; }
.site-footer__brand { margin: 0; font-size: 1.3rem; font-weight: 800; letter-spacing: -0.02em; }
.site-footer__heading { margin: 0 0 0.5rem; font-weight: 700; }
.site-footer__legal { margin: 2rem 0 0; padding-top: 1rem; border-top: 1px solid var(--c-border); color: var(--c-muted); font-size: 0.9rem; }

.breadcrumb ol { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 0 0 1rem; }
.breadcrumb li + li::before { content: "/"; margin-right: 0.5rem; color: var(--c-muted); }

.card-list { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); }
.card-list li { border: 1px solid var(--c-border); border-radius: var(--radius); padding: 1rem; display: grid; gap: 0.25rem; }
.card-list a { font-weight: 700; }

details { border: 1px solid var(--c-border); border-radius: var(--radius); padding: 0.75rem 1rem; margin-bottom: 0.75rem; }
summary { cursor: pointer; font-weight: 600; min-height: 2.75rem; display: flex; align-items: center; }

@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; } }
[data-a11y-motion="reduce"] *, [data-a11y-motion="reduce"] *::before, [data-a11y-motion="reduce"] *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
@media (forced-colors: active) { .button, .icon-button, .badge { border: 1px solid ButtonText; } }

@media (max-width: 40rem) {
  .site-header { position: static; }
  .site-header__brand { margin-right: auto; }
  .site-header__icons { gap: 0; }
  .site-search { order: 3; flex-basis: 100%; max-width: none; }
}

{# User-chosen themes (accessibility panel): generated from src/_data/themes.json. #}
{%- for name, theme in themes %}
[data-a11y-theme="{{ name }}"] {
{%- for key, value in theme.colors %} --c-{{ key }}: {{ value }};{% endfor %} }
{%- endfor %}

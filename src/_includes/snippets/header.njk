{%- if storefront.promo %}
<aside class="promo-bar" aria-label="Announcement"><p class="container">{{ storefront.promo }}</p></aside>
{%- endif %}
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/">{{ site.name }}</a>
    <form class="site-search" role="search" action="/products/" method="get">
      <label class="visually-hidden" for="site-search-input">Search products</label>
      <input id="site-search-input" type="search" name="q" placeholder="Search products" autocomplete="off" data-search-input>
      <button type="submit" class="site-search__submit">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        <span class="visually-hidden">Search</span>
      </button>
    </form>
    <div class="site-header__icons">
    <a class="cart-button" href="/wishlist/">{% include "snippets/icon-heart.njk" %}<span class="cart-button__count" data-wishlist-count hidden>0</span><span class="visually-hidden">Wishlist</span></a>
    <a class="cart-button" href="/compare/">{% include "snippets/icon-compare.njk" %}<span class="cart-button__count" data-compare-count hidden>0</span><span class="visually-hidden">Compare</span></a>
    {%- if mode != "affiliate" %}
    <a class="cart-button" href="/cart/" data-cart-open aria-haspopup="dialog">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6 5 3H2"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
      <span class="cart-button__count" data-cart-count hidden>0</span>
      <span class="visually-hidden">Cart</span>
    </a>
    {%- endif %}
    </div>
  </div>
</header>
<nav class="site-menu" aria-label="Main">
  <div class="container site-menu__inner">
    {%- if catalog.collections.length %}
    <details class="category-menu" data-category-menu>
      <summary>Browse collections</summary>
      <ul class="category-menu__panel">
        {%- for collection in catalog.collections %}
        <li>
          <a class="category-menu__title" href="{{ collection.url }}">{{ collection.title }}</a>
          {%- if collection.products.length %}
          <ul>
            {%- for item in collection.products | head(4) %}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{% endfor %}
          </ul>
          {%- endif %}
        </li>
        {%- endfor %}
      </ul>
    </details>
    {%- endif %}
    <ul class="site-nav">
      {%- for item in navigation.main %}
      <li><a href="{{ item.url }}"{% if page.url and (page.url == item.url or (item.url != "/" and page.url.startsWith(item.url))) %} aria-current="page"{% endif %}>{{ item.text }}</a></li>
      {%- endfor %}
    </ul>
  </div>
</nav>

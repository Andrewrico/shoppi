---
layout: layouts/base.njk
title: Blog
description: News and guides.
permalink: /blog/
knowledge: true
---
<div class="container section">
  <h1>Blog</h1>
  <ul class="post-grid">
    {%- for post in collections.posts %}
    <li class="post-card">
      <p class="meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></p>
      <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      <p>{{ post.data.description }}</p>
    </li>
    {%- endfor %}
  </ul>
</div>

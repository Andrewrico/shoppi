---js
{
  layout: "layouts/base.njk",
  title: "Your cart",
  description: "Review your cart and check out.",
  eleventyExcludeFromCollections: true,
  // No cart page in affiliate mode: returning false skips the file.
  eleventyComputed: { permalink: (data) => (data.mode === "affiliate" ? false : "/cart/") },
}
---
<div class="container section">
  <h1>Your cart</h1>
  <div data-cart-page>
    <noscript><p>The cart needs JavaScript. <a href="mailto:{{ site.email }}">Email us</a> to order.</p></noscript>
  </div>
</div>

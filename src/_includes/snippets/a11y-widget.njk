<div class="a11y-widget" data-a11y-widget>
  <button class="a11y-widget__launcher" type="button" data-a11y-launcher aria-expanded="false" aria-controls="a11y-panel" aria-label="Accessibility settings">
    <svg aria-hidden="true" viewBox="2.5 1.5 11 13" focusable="false"><path d="M9.25 3.75C9.25 4.44036 8.69036 5 8 5C7.30964 5 6.75 4.44036 6.75 3.75C6.75 3.05964 7.30964 2.5 8 2.5C8.69036 2.5 9.25 3.05964 9.25 3.75ZM12 8H9.41901L11.2047 13H9.081L8 9.97321L6.91901 13H4.79528L6.581 8H4V6H12V8Z"/></svg>
  </button>
  <section class="a11y-widget__panel" id="a11y-panel" data-a11y-panel aria-labelledby="a11y-title" hidden>
    <header class="a11y-widget__header">
      <h2 id="a11y-title">Accessibility</h2>
      <button class="icon-button" type="button" data-a11y-close aria-label="Close accessibility settings">&times;</button>
    </header>
    <fieldset>
      <legend>Color theme</legend>
      <div class="a11y-widget__row">
        <button type="button" data-theme-choice="default" aria-pressed="true">Default</button>
        {%- for name, theme in themes %}
        <button type="button" data-theme-choice="{{ name }}" aria-pressed="false">{{ theme.label }}</button>
        {%- endfor %}
      </div>
    </fieldset>
    <div>
      <label for="a11y-size">Text size <output data-size-output for="a11y-size">100%</output></label>
      <input id="a11y-size" type="range" min="100" max="150" step="5" value="100">
    </div>
    <div>
      <label for="a11y-spacing">Line spacing <output data-spacing-output for="a11y-spacing">1.5×</output></label>
      <input id="a11y-spacing" type="range" min="1.4" max="2.2" step="0.1" value="1.5">
    </div>
    <fieldset>
      <legend>Reading aids</legend>
      <label><input type="checkbox" data-a11y-setting="readableFont"> Readable font</label>
      <label><input type="checkbox" data-a11y-setting="underlineLinks"> Underline links</label>
      <label><input type="checkbox" data-a11y-setting="readingGuide"> Reading guide</label>
      <label><input type="checkbox" data-a11y-setting="reduceMotion"> Reduce motion</label>
    </fieldset>
    <div class="a11y-widget__row">
      <button type="button" data-a11y-read>Read page aloud</button>
      <button type="button" data-a11y-reset>Reset</button>
    </div>
    <p role="status" aria-live="polite" data-a11y-status></p>
  </section>
</div>

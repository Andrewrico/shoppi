<article class="product-card" data-search-text="{{ product.title }} {{ product.description }} {{ product.collection }} {{ product.tags | join(' ') }}" data-handle="{{ product.handle }}" data-title="{{ product.title }}" data-collection="{{ product.collection }}" data-available="{{ product.available }}" data-order="{{ loop.index }}"{% if mode != "affiliate" or store.affiliate.showPrices %} data-price="{{ product.priceMin }}"{% endif %}>
  {%- if mode != "affiliate" and product.available and product.variants[0].compareAtPrice %}
  <span class="badge product-card__badge">Save {{ (100 - product.variants[0].price * 100 / product.variants[0].compareAtPrice) | round }}%</span>
  {%- endif %}
  <div class="product-card__actions">
    <button type="button" class="card-action" data-wishlist-toggle="{{ product.handle }}" aria-pressed="false" aria-label="Wishlist: {{ product.title }}">{% include "snippets/icon-heart.njk" %}</button>
    <button type="button" class="card-action" data-compare-toggle="{{ product.handle }}" aria-pressed="false" aria-label="Compare: {{ product.title }}">{% include "snippets/icon-compare.njk" %}</button>
  </div>
  <div class="product-card__frame">
    <a class="product-card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">{% include "snippets/product-image.njk" %}</a>
    {%- if not noQuickView %}
    <a class="product-card__quick" href="{{ product.url }}" data-quick-view>Quick view<span class="visually-hidden"> of {{ product.title }}</span></a>
    {%- endif %}
  </div>
  {% set tag = cardHeading or "h2" %}<{{ tag }} class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></{{ tag }}>
  {%- if mode == "affiliate" %}
  {%- if store.affiliate.showPrices %}<p class="product-card__price">{{ product.priceMin | money(store.currency, store.locale) }}</p>{% endif %}
  {%- if product.available %}{% include "snippets/affiliate-button.njk" %}{% else %}<p class="product-card__price"><span class="badge">Unavailable</span></p>{% endif %}
  {%- else %}
  <p class="product-card__price">
    {%- if not product.available %}<span class="badge">Sold out</span>
    {%- else %}{% if product.priceMin != product.priceMax %}From {% endif %}{{ product.priceMin | money(store.currency, store.locale) }}
    {%- if product.variants[0].compareAtPrice %} <s><span class="visually-hidden">Regular price </span>{{ product.variants[0].compareAtPrice | money(store.currency, store.locale) }}</s>{% endif %}{% endif -%}
  </p>
  {%- if product.available and product.variants.length == 1 %}
  <button type="button" class="button" data-add-to-cart data-variant-id="{{ product.variants[0].id }}">Add to cart<span class="visually-hidden"> {{ product.title }}</span></button>
  {%- elif product.available %}
  <a class="button" href="{{ product.url }}">Choose options<span class="visually-hidden"> for {{ product.title }}</span></a>
  {%- endif %}
  {%- endif %}
</article>

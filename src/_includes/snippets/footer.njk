<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>&copy; {{ build.year }} {{ site.name }}. <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    <nav aria-label="Footer">
      <ul class="site-nav">
        {%- for item in navigation.footer %}<li><a href="{{ item.url }}">{{ item.text }}</a></li>{% endfor %}
      </ul>
    </nav>
  </div>
</footer>

{#- Native <dialog>: the browser traps focus, closes on Escape and makes the page behind inert. -#}
<dialog id="cart-dialog" class="cart-dialog" aria-labelledby="cart-title">
  <div class="cart-dialog__header">
    <h2 id="cart-title">Your cart</h2>
    <button type="button" class="icon-button" data-cart-close aria-label="Close cart">&times;</button>
  </div>
  <div data-cart-body></div>
</dialog>
<p class="visually-hidden" role="status" aria-live="polite" data-cart-status></p>
